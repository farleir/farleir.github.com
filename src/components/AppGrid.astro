---
const apps = [
  {
    title: {
      "pt-BR": "AHP Decision Maker",
      "en-US": "AHP Decision Maker",
      "es-ES": "AHP Decision Maker"
    },
    description: {
      "pt-BR": "Ferramenta interativa para tomada de decisões complexas usando o Processo Hierárquico Analítico.",
      "en-US": "Interactive tool for complex decision making using the Analytic Hierarchy Process.",
      "es-ES": "Herramienta interactiva para la toma de decisiones complejas utilizando el Proceso Jerárquico Analítico."
    },
    icon: "puzzle",
    link: "https://ahp.farleir.com",
    status: {
      "pt-BR": "Ativo",
      "en-US": "Active",
      "es-ES": "Activo"
    },
    statusType: "active"
  },
  {
    title: {
      "pt-BR": "Analista de Bagé com IA",
      "en-US": "Analista de Bagé with AI",
      "es-ES": "Analista de Bagé con IA"
    },
    description: {
      "pt-BR": "Assistente de IA com personalidade única (gaúcha e tradicionalista) para análises e suporte inteligente.",
      "en-US": "AI assistant with a unique regional persona for analysis and smart support.",
      "es-ES": "Asistente de IA con personalidad regional única para análisis y soporte inteligente."
    },
    icon: "comment",
    link: "#",
    status: {
      "pt-BR": "Em migração",
      "en-US": "Migrating",
      "es-ES": "En migración"
    },
    statusType: "migrating"
  },
  {
    title: {
      "pt-BR": "PDF2Chat",
      "en-US": "PDF2Chat",
      "es-ES": "PDF2Chat"
    },
    description: {
      "pt-BR": "Converse diretamente com seus documentos PDF e extraia insights instantâneos.",
      "en-US": "Chat directly with your PDF documents and extract instant insights.",
      "es-ES": "Chatea directamente con tus documentos PDF y extrae información instantánea."
    },
    icon: "document",
    link: "#",
    status: {
      "pt-BR": "Em migração",
      "en-US": "Migrating",
      "es-ES": "En migración"
    },
    statusType: "migrating"
  },
  {
    title: {
      "pt-BR": "URLeIMG2ALT",
      "en-US": "URLeIMG2ALT",
      "es-ES": "URLeIMG2ALT"
    },
    description: {
      "pt-BR": "Automação de acessibilidade: gere textos alternativos para imagens e URLs automaticamente.",
      "en-US": "Accessibility automation: generate alt texts for images and URLs automatically.",
      "es-ES": "Automatización de accesibilidad: genera textos alternativos para imágenes y URLs automáticamente."
    },
    icon: "external",
    link: "#",
    status: {
      "pt-BR": "Em migração",
      "en-US": "Migrating",
      "es-ES": "En migración"
    },
    statusType: "migrating"
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
  {apps.map((app) => (
    <div class="group relative p-6 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-sky-500/50 transition-all duration-300">
      <div class="flex items-center gap-4 mb-4">
        <div class="p-3 rounded-lg bg-sky-500/10 text-sky-400 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-white group-hover:text-sky-400 transition-colors">
            <span data-lang-content="pt-BR">{app.title["pt-BR"]}</span>
            <span data-lang-content="en-US">{app.title["en-US"]}</span>
            <span data-lang-content="es-ES">{app.title["es-ES"]}</span>
          </h3>
          <span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full font-bold inline-block mt-1 ${app.statusType === 'active' ? 'bg-green-500/20 text-green-400' : 'bg-yellow-500/20 text-yellow-400'}`}>
            <span data-lang-content="pt-BR">{app.status["pt-BR"]}</span>
            <span data-lang-content="en-US">{app.status["en-US"]}</span>
            <span data-lang-content="es-ES">{app.status["es-ES"]}</span>
          </span>
        </div>
      </div>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        <span data-lang-content="pt-BR">{app.description["pt-BR"]}</span>
        <span data-lang-content="en-US">{app.description["en-US"]}</span>
        <span data-lang-content="es-ES">{app.description["es-ES"]}</span>
      </p>
      <a href={app.link} class="inline-flex items-center text-sky-400 text-sm font-medium hover:gap-2 transition-all">
        <span data-lang-content="pt-BR">Acessar Aplicativo</span>
        <span data-lang-content="en-US">Access Application</span>
        <span data-lang-content="es-ES">Acceder a la Aplicación</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  ))}
</div>
