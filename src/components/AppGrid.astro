---
const apps = [
  {
    title: "AHP Decision Maker",
    description: "Ferramenta interativa para tomada de decisões complexas usando o Processo Hierárquico Analítico.",
    icon: "puzzle",
    link: "https://ahp.farleir.com", // Assuming future URL
    status: "Ativo"
  },
  {
    title: "Analista de Bagé",
    description: "Assistente de IA com personalidade única para análises e suporte inteligente.",
    icon: "comment",
    link: "#",
    status: "Em migração"
  },
  {
    title: "PDF2Chat",
    description: "Converse diretamente com seus documentos PDF e extraia insights instantâneos.",
    icon: "document",
    link: "#",
    status: "Em migração"
  },
  {
    title: "URLeIMG2ALT",
    description: "Automação de acessibilidade: gere textos alternativos para imagens e URLs automaticamente.",
    icon: "external",
    link: "#",
    status: "Em migração"
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
  {apps.map((app) => (
    <div class="group relative p-6 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-sky-500/50 transition-all duration-300">
      <div class="flex items-center gap-4 mb-4">
        <div class="p-3 rounded-lg bg-sky-500/10 text-sky-400 group-hover:scale-110 transition-transform">
          {/* Using simple SVG placeholders for icons since we are in a component */}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-white group-hover:text-sky-400 transition-colors">{app.title}</h3>
          <span class={`text-xs px-2 py-0.5 rounded-full ${app.status === 'Ativo' ? 'bg-green-500/20 text-green-400' : 'bg-yellow-500/20 text-yellow-400'}`}>
            {app.status}
          </span>
        </div>
      </div>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        {app.description}
      </p>
      <a href={app.link} class="inline-flex items-center text-sky-400 text-sm font-medium hover:gap-2 transition-all">
        Acessar Aplicativo <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  ))}
</div>
