---
import timelineData from '../data/timeline.json';

interface Props {
  lang?: string;
}

const { lang = 'pt-BR' } = Astro.props;
const experience = timelineData.experience;
const education = timelineData.education;
const certifications = timelineData.certifications;
---

<div class="space-y-12 not-prose">
  <div class="relative border-l-2 border-sky-500/30 ml-4 pl-8 space-y-12">
    {experience.map((item) => (
      <div class="relative">
        <div class="absolute -left-[41px] top-0 w-5 h-5 rounded-full bg-sky-500 border-4 border-slate-900 shadow-[0_0_10px_rgba(14,165,233,0.5)]"></div>
        <div class="p-6 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/[0.07] transition-all">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-4">
            <h3 class="text-xl font-bold text-white">{item.translations[lang]?.title || item.translations['pt-BR']?.title}</h3>
            {item.isCurrent && (
              <span class="text-[10px] uppercase tracking-wider px-2 py-1 bg-sky-500/20 text-sky-400 rounded-md font-bold">
                Atual
              </span>
            )}
          </div>
          <p class="text-sky-400 font-medium mb-3 text-sm">{item.translations[lang]?.company || item.translations['pt-BR']?.company}</p>
          <p class="text-slate-400 text-sm leading-relaxed">
            {item.translations[lang]?.description || item.translations['pt-BR']?.description}
          </p>
        </div>
      </div>
    ))}
  </div>
  
  <div class="mt-20">
    <h2 class="text-3xl font-bold text-white mb-8 text-center">Formação Acadêmica</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {education.map((edu) => (
        <div class="p-6 rounded-xl bg-white/5 border border-white/10 hover:border-sky-500/30 transition-all">
          <h3 class="text-lg font-bold text-white mb-2">{edu.translations[lang]?.degree || edu.translations['pt-BR']?.degree}</h3>
          <p class="text-sky-400 text-sm mb-3">{edu.translations[lang]?.institution || edu.translations['pt-BR']?.institution}</p>
          <p class="text-slate-400 text-sm italic">{edu.translations[lang]?.details || edu.translations['pt-BR']?.details}</p>
        </div>
      ))}
    </div>
  </div>

  {certifications && (
    <div class="mt-20">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">Certificações & Treinamentos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {certifications.map((cert) => {
          const trans = cert.translations[lang] || cert.translations['pt-BR'];
          const title = typeof trans === 'object' ? trans.title : trans;
          const description = typeof trans === 'object' ? trans.description : '';
          
          return (
            <div class="flex flex-col gap-2 p-5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/[0.07] transition-all">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 text-sky-400" set:html={cert.icon} />
                <p class="text-white font-bold text-sm leading-snug">
                  {title}
                </p>
              </div>
              {description && (
                <p class="text-slate-400 text-xs leading-relaxed mt-1">
                  {description}
                </p>
              )}
              {cert.issued && (
                <p class="text-[10px] uppercase tracking-wider text-slate-500 font-bold mt-2">
                  Emitida em: {new Date(cert.issued).toLocaleDateString(lang)} {cert.expires && `• Expira em: ${new Date(cert.expires).toLocaleDateString(lang)}`}
                </p>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}
</div>
