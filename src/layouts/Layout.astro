---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- SEO & Metadata -->
		<title>{title}</title>
		<meta name="description" content="Farleir Hub - Cloud Architect & IT Infrastructure Expert. Especialista em Governança de Dados (LGPD/IA)." />
		<meta name="keywords" content="Farleir, IT Infrastructure, Cloud Architect, LGPD, IA, Governance" />
		<link rel="canonical" href="https://www.farleir.com/" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://www.farleir.com/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Especialista em Arquitetura de Cloud (AWS), Infraestrutura de TI, Telecom e Governança de Dados." />
		<meta property="og:image" content="https://www.farleir.com/images/og-image.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://www.farleir.com/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content="Especialista em Arquitetura de Cloud (AWS), Infraestrutura de TI, Telecom e Governança de Dados." />
		<meta property="twitter:image" content="https://www.farleir.com/images/og-image.png" />

		<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
		<link
			rel="stylesheet"
			as="style"
			onload="this.rel='stylesheet'"
			href="https://fonts.googleapis.com/css2?display=swap&family=Inter%3Awght%40400%3B500%3B700%3B900&family=Noto+Sans%3Awght%40400%3B500%3B700%3B900"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
	</head>
	<body>
		<div class="relative flex h-auto min-h-screen w-full flex-col bg-[#111418] dark group/design-root overflow-x-hidden" style='font-family: Inter, "Noto Sans", sans-serif;'>
			<div class="layout-container flex h-full grow flex-col">
				<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-b-[#283039] px-10 py-3">
					<div class="flex items-center gap-4 text-white">
						<div class="size-4">
							<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M44 4H30.6666V17.3334H17.3334V30.6666H4V44H44V4Z" fill="currentColor"></path></svg>
						</div>
						<h2 class="text-white text-lg font-bold leading-tight tracking-[-0.015em]">Farleir Hub</h2>
					</div>
					<div class="flex flex-1 justify-end gap-8">
						<div class="flex items-center gap-9">
							<a class="text-white text-sm font-medium leading-normal hover:text-[#0c7ff2] transition-colors" href="/">Início</a>
							<a class="text-white text-sm font-medium leading-normal hover:text-[#0c7ff2] transition-colors" href="/aplicativos">Aplicativos</a>
							<a class="text-white text-sm font-medium leading-normal hover:text-[#0c7ff2] transition-colors" href="/portfolio">Portfólio</a>
						</div>
					</div>
				</header>
				<div class="px-4 md:px-10 lg:px-40 flex flex-1 justify-center py-5">
					<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
						<slot />
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
