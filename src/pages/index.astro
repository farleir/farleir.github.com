---
import Layout from '../layouts/Layout.astro';
import AppGrid from '../components/AppGrid.astro';
---

<Layout title="Farleir Hub - Início">
  <div class="flex flex-col gap-12">
    
    <!-- Hero Section -->
    <header id="hero" class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-16">
      
      <!-- Left Column (Bio & Intro) -->
      <div class="flex flex-col gap-8 flex-grow max-w-2xl">
        <div class="space-y-6">
          <div class="flex flex-col md:flex-row md:items-center gap-6">
            <img src="/images/avatar.png" alt="Farleir" 
                 class="w-16 h-16 md:w-20 md:h-20 rounded-full border-2 border-white/10 p-1 bg-white/5 ring-8 ring-white/5 shadow-2xl shadow-cyan-500/10 flex-shrink-0">
            <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400">
              <span data-lang-content="pt-BR">Olá. Eu sou o Farleir.</span>
              <span data-lang-content="en-US">Hello. I'm Farleir.</span>
              <span data-lang-content="es-ES">Hola. Soy Farleir.</span>
            </h1>
          </div>
          <p class="text-xl text-slate-400 font-light leading-relaxed">
            <span data-lang-content="pt-BR">Expert em Infraestrutura de TI, Cloud Architect e Governança de Dados (LGPD/IA).</span>
            <span data-lang-content="en-US">IT Infrastructure Expert, Cloud Architect, and Data Governance Specialist (LGPD/AI).</span>
            <span data-lang-content="es-ES">Experto en Infraestructura de TI, Arquitecto Cloud y Especialista en Gobernanza de Datos (LGPD/IA).</span>
          </p>
          
          <!-- Professional Trajectory Summary -->
          <div class="flex gap-4 p-5 rounded-2xl bg-white/[0.02] border border-white/5 group hover:border-sky-500/20 transition-all">
            <div class="flex flex-col gap-1 border-r border-white/10 pr-4">
              <span class="text-white font-bold text-lg">20+</span>
              <span class="text-[9px] uppercase tracking-widest text-slate-500">
                <span data-lang-content="pt-BR">Anos eXP.</span>
                <span data-lang-content="en-US">Years Exp.</span>
                <span data-lang-content="es-ES">Años Exp.</span>
              </span>
            </div>
            <div class="flex flex-col gap-1 px-4">
              <p class="text-sm text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">
                <span data-lang-content="pt-BR">
                  <span class="text-white font-medium">Nerd de plantão, analista por profissão, tecnologista por vocação.</span> 
                  Construindo ecossistemas robustos e seguros por design, unindo o rigor acadêmico à escala industrial, para transformar dados em ferramentas e soluções práticas.
                </span>
                <span data-lang-content="en-US">
                  <span class="text-white font-medium">Nerd on duty, analyst by profession, technologist by vocation.</span> 
                  Building robust and secure ecosystems by design, combining academic rigor with industrial scale to transform data into practical tools and solutions.
                </span>
                <span data-lang-content="es-ES">
                  <span class="text-white font-medium">Nerd de guardia, analista de profesión, tecnólogo por vocación.</span> 
                  Construyendo ecosistemas robustos y seguros por diseño, uniendo el rigor académico con la escala industrial para transformar datos en herramientas y soluciones prácticas.
                </span>
              </p>
            </div>
          </div>
        </div>
        
        <!-- Social buttons -->
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="https://go.farleir.com/linkedin" target="_blank" rel="noopener noreferrer" 
             class="flex items-center gap-2 px-6 py-3 bg-white text-black font-bold rounded-full hover:bg-slate-200 transition-all hover:scale-105 active:scale-95 shadow-xl shadow-white/5 text-xs uppercase tracking-widest">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg> LinkedIn
          </a>
          <a href="https://go.farleir.com/lattes" target="_blank" rel="noopener noreferrer" 
             class="flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 rounded-full hover:bg-white/10 transition-all hover:border-white/20 text-xs uppercase tracking-widest text-slate-300">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/></svg> Lattes
          </a>
          <a href="https://go.farleir.com/github" target="_blank" rel="noopener noreferrer" 
             class="flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 rounded-full hover:bg-white/10 transition-all hover:border-white/20 text-xs text-slate-300 font-bold uppercase tracking-widest">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg> GitHub
          </a>
        </div>
      </div>

      <!-- Right Column (Sidebar: Languages & Badges) -->
      <div class="flex flex-col gap-6 items-center self-stretch lg:self-start flex-shrink-0 lg:mt-4 w-full lg:w-auto">
        <!-- Language Switcher Pill -->
        <div class="flex items-center gap-1 p-1 rounded-full bg-white/5 border border-white/10 shadow-2xl" role="navigation" aria-label="Language Selector">
          <button onclick="setLanguage('pt-BR')" id="lang-btn-pt-BR" class="lang-btn px-3 py-1.5 rounded-full text-xs font-bold transition-all duration-300" aria-label="Alterar idioma para Português">PT</button>
          <button onclick="setLanguage('en-US')" id="lang-btn-en-US" class="lang-btn px-3 py-1.5 rounded-full text-xs font-bold transition-all duration-300" aria-label="Change language to English">EN</button>
          <button onclick="setLanguage('es-ES')" id="lang-btn-es-ES" class="lang-btn px-3 py-1.5 rounded-full text-xs font-bold transition-all duration-300" aria-label="Cambiar idioma a Español">ES</button>
        </div>

        <!-- Badges Card -->
        <div class="flex lg:flex-col flex-row gap-6 p-6 bg-white/5 border border-white/10 rounded-3xl w-full lg:w-auto justify-center items-center">
          <a href="https://go.farleir.com/aws" target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 group">
            <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center badge-icon shadow-lg group-hover:border-orange-500/50 group-hover:bg-orange-500/10 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-orange-400 drop-shadow-[0_0_8px_rgba(251,146,60,0.5)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"/></svg>
            </div>
            <span class="text-[9px] uppercase tracking-wider text-slate-400 text-center font-bold group-hover:text-white transition-colors">AWS<br>Skills</span>
          </a>
          <a href="https://go.farleir.com/google-skills" target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 group">
            <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center badge-icon shadow-lg group-hover:border-blue-500/50 group-hover:bg-blue-500/10 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-blue-400 drop-shadow-[0_0_8px_rgba(96,165,250,0.5)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19A3.5 3.5 0 0 0 21 15.5c0-2.79-2.54-4.5-5-4.5-.42-1.89-1.78-3.5-3.5-4-2.42-.71-4.75.58-5.5 2.5C4.54 9.5 2 11.79 2 14.5c0 2.79 2.54 4.5 5 4.5Z"/></svg>
            </div>
            <span class="text-[9px] uppercase tracking-wider text-slate-400 text-center font-bold group-hover:text-white transition-colors">Google<br>Cloud</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Skills Section -->
    <div>
      <h2 class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] border-b border-[#283039] pb-3 mb-4">
        <span data-lang-content="pt-BR">Habilidades & Especialidades</span>
        <span data-lang-content="en-US">Skills & Specialties</span>
        <span data-lang-content="es-ES">Habilidades y Especialidades</span>
      </h2>
      <div class="flex gap-3 py-3 flex-wrap">
        {['Linux', 'Docker', 'AWS', 'Azure', 'Python', 'Astro', 'IA', 'Segurança', 'Infraestrutura', 'Node.js'].map(skill => (
          <div class="flex h-8 shrink-0 items-center justify-center rounded-lg bg-white/5 border border-white/10 px-4">
            <p class="text-white text-sm font-medium leading-normal">{skill}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Featured Apps Section -->
    <div>
      <h2 class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] border-b border-[#283039] pb-3 mb-6">
        <span data-lang-content="pt-BR">Aplicativos (Destaques)</span>
        <span data-lang-content="en-US">Featured Applications</span>
        <span data-lang-content="es-ES">Aplicaciones Destacadas</span>
      </h2>
      <div>
        <AppGrid />
      </div>
    </div>

  </div>
</Layout>
