---
import Layout from '../layouts/Layout.astro';
import AppGrid from '../components/AppGrid.astro';
import PortfolioTimeline from '../components/PortfolioTimeline.astro';
---

<Layout title="Farleir Hub - Início">
  <div class="flex flex-col gap-8">
    <div class="flex p-4 @container">
      <div class="flex w-full flex-col gap-4 items-center">
        <div class="flex gap-4 flex-col items-center">
          <div
            class="bg-center bg-no-repeat aspect-square bg-cover rounded-full min-h-32 w-32 border-2 border-[#283039]"
            style='background-image: url("../../assets/houston.webp");'
          ></div>
          <div class="flex flex-col items-center justify-center">
            <p class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] text-center">Farleir Minozzo</p>
            <p class="text-[#9dabb9] text-base font-normal leading-normal text-center">Infraestrutura, Cloud, Segurança e Inovação</p>
            <p class="text-[#9dabb9] text-base font-normal leading-normal text-center">Centro do ecossistema SaaS e agentes autônomos.</p>
          </div>
        </div>
      </div>
    </div>

    <div>
      <h2 class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5 border-b border-[#283039] mb-4">Habilidades</h2>
      <div class="flex gap-3 p-3 flex-wrap pr-4">
        {['Linux', 'Docker', 'AWS', 'Azure', 'Python', 'Astro', 'IA', 'Segurança', 'Infraestrutura', 'Node.js'].map(skill => (
          <div class="flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-[#283039] pl-4 pr-4">
            <p class="text-white text-sm font-medium leading-normal">{skill}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5 border-b border-[#283039] mb-4">Aplicativos (Destaques)</h2>
      <div class="px-4">
        <AppGrid />
      </div>
    </div>
  </div>
</Layout>
